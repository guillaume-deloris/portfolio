<section class="hero">
    <p class="page__tag">// scores</p>
    <h1 class="page__title">Leaderboard</h1>
    <p class="page__desc">Vos meilleurs scores en ligne.</p>
</section>

<section class="home-section">
    <p class="page__tag">// ajouter un score</p>
    <form class="contact-form" action="/scores" method="POST" style="max-width: 480px; margin-top: 20px;">
        <div class="form-group">
            <label class="form-label">Joueur</label>
            <input class="form-input" type="text" name="player" required maxlength="50">
        </div>
        <div class="form-group">
            <label class="form-label">Jeu</label>
            <input class="form-input" type="text" name="game" required maxlength="50">
        </div>
        <div class="form-group">
            <label class="form-label">Score</label>
            <input class="form-input" type="number" name="score" required>
        </div>
        <button type="submit" class="btn">Enregistrer →</button>
    </form>
</section>

<section class="home-section">
    <p class="page__tag">// classement</p>
    {{#if scores.length}}
    <table style="width: 100%; border-collapse: collapse; margin-top: 20px;">
        <thead>
            <tr>
                <th style="text-align: left; padding: 8px 12px; font-size: var(--text-xs); color: var(--text-muted); letter-spacing: 0.1em; border-bottom: 1px solid var(--border);">RANG</th>
                <th style="text-align: left; padding: 8px 12px; font-size: var(--text-xs); color: var(--text-muted); letter-spacing: 0.1em; border-bottom: 1px solid var(--border);">JOUEUR</th>
                <th style="text-align: left; padding: 8px 12px; font-size: var(--text-xs); color: var(--text-muted); letter-spacing: 0.1em; border-bottom: 1px solid var(--border);">JEU</th>
                <th style="text-align: right; padding: 8px 12px; font-size: var(--text-xs); color: var(--text-muted); letter-spacing: 0.1em; border-bottom: 1px solid var(--border);">SCORE</th>
            </tr>
        </thead>
        <tbody>
            {{#each scores}}
            <tr>
                <td style="padding: 10px 12px; font-size: var(--text-sm); color: var(--accent);">#{{add @index 1}}</td>
                <td style="padding: 10px 12px; font-size: var(--text-sm); color: var(--text);">{{this.player}}</td>
                <td style="padding: 10px 12px; font-size: var(--text-sm); color: var(--text-muted);">{{this.game}}</td>
                <td style="padding: 10px 12px; font-size: var(--text-sm); color: var(--accent); text-align: right;">{{this.score}}</td>
            </tr>
            {{/each}}
        </tbody>
    </table>
    {{else}}
    <p style="margin-top: 20px; color: var(--text-muted); font-size: var(--text-sm);">Aucun score enregistré pour l'instant.</p>
    {{/if}}
</section>